{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing scoped to the decision logic where a silently wrong branch is most costly: the fraud rules, the underwriting policy, reason-code governance, the feature policy and the release gates. Run with `npm run test:mutation`.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.js" },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/decisioning/fraud-rules/rules.js",
    "src/decisioning/underwriting/policy.js",
    "src/decisioning/reason-codes/catalog.js",
    "src/decisioning/policies/feature_policy.js",
    "src/decisioning/investigation/workflow.js",
    "src/evaluation/gates.js",
    "src/governance/audit.js"
  ],
  "thresholds": { "high": 85, "low": 70, "break": 60 },
  "timeoutMS": 30000,
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
