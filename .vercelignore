# .vercelignore — upload only what the static site build needs (allowlist).
#
# Everything at the repository root is ignored, then the build inputs are re-included. Directory
# rules have no trailing slash: the Vercel CLI tests a directory's path without one, so a rule
# like !/src/ never matches it and the whole directory is left out of the upload. This keeps
# out, among others: data/public-record/raw/ (SEC and FRED raw snapshots and the eight filing
# HTMLs in raw/filings/), reports/, analytics/data/ and the rest of analytics/, .stryker-tmp*/,
# coverage/, dist/, any Python virtual environment (.venv/, venv/), docs/ (including docs/sprints/),
# local .env files, tests and server code that the static build never reads.
/*

# Build entry, configuration and dependencies (npm ci needs the lockfile; .nvmrc pins Node).
!/index.html
!/vite.config.js
!/package.json
!/package-lock.json
!/.nvmrc

# Application source and static files.
!/src
!/public
/public/artifacts

# Prebuild step: scripts/prepare_demo_assets.js copies the published artifacts into public/.
# !/artifacts includes artifacts/model-snapshot, the committed model outputs. analytics/artifacts
# (gitignored, present only on a machine that ran the Python pipeline) stays out of the upload, so a
# CLI deploy from any machine serves the committed snapshot, as the GitHub Pages build does.
!/scripts
/scripts/*
!/scripts/prepare_demo_assets.js
!/artifacts

# The pinned public-record snapshot the Public record tab imports (raw files, filings and the
# filing page excerpt, which only the tests read, excluded).
!/data
/data/*
!/data/public-record
/data/public-record/*
!/data/public-record/sunlight-quarterly.json
!/data/public-record/manifest.json
!/data/public-record/events.json
# Daily 10-year Treasury yields for the Funding & Rates rate paths.
!/data/public-record/dgs10-daily.json
# Public data (peer lenders, complaint counts, credit conditions, court-filing facts) and its config.
!/data/public-record/public-data-config.json
!/data/public-record/peers-quarterly.json
!/data/public-record/cfpb-complaints.json
!/data/public-record/macro-credit.json
!/data/public-record/court-filings.json

# Tests are not part of the build.
/src/**/*.test.js
/src/**/*.test.jsx
/src/ui/test-setup.js
