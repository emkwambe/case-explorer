# Case Explorer Environment Variables
# ========================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# -------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------

# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=case_explorer
DB_USER=postgres
DB_PASSWORD=

# Optional: Full connection string (overrides individual settings)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/case_explorer

# Connection pool settings
DB_MAX_POOL_SIZE=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# -------------------------------------------
# REDIS CONFIGURATION (Optional - for caching)
# -------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# -------------------------------------------
# API CONFIGURATION
# -------------------------------------------

API_PORT=3000
API_HOST=localhost
API_SECRET=your-super-secret-key-here-generate-with-openssl-rand-32
JWT_SECRET=another-super-secret-key-for-jwt-tokens
JWT_EXPIRES_IN=24h

# -------------------------------------------
# RATE LIMITING
# -------------------------------------------

# Requests per hour by tier
RATE_LIMIT_FREE=1000
RATE_LIMIT_PRO=10000
RATE_LIMIT_ENTERPRISE=100000
RATE_LIMIT_WINDOW_MINUTES=60

# -------------------------------------------
# AUTHENTICATION
# -------------------------------------------

# JWT tokens
JWT_ALGORITHM=HS256

# Session
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE_MS=86400000  # 24 hours

# -------------------------------------------
# CLOUDFLARE CONFIGURATION (Optional)
# -------------------------------------------

CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_PAGES_PROJECT_NAME=case-explorer

# -------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------

NODE_ENV=development  # development, staging, production
LOG_LEVEL=info  # error, warn, info, debug, trace

# Batch generation settings
MAX_BATCH_SIZE=10000
BATCH_CHUNK_SIZE=1000

# -------------------------------------------
# FILE UPLOADS (Optional - for document storage)
# -------------------------------------------

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/json,text/csv

# -------------------------------------------
# MONITORING & ANALYTICS
# -------------------------------------------

# Sentry (Error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Cloudflare Analytics
CF_ANALYTICS_TOKEN=

# -------------------------------------------
# EMAIL CONFIGURATION (Optional - for notifications)
# -------------------------------------------

# SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@caseexplorer.com
SMTP_FROM_NAME=Case Explorer

# -------------------------------------------
# EXTERNAL SERVICES (Optional)
# -------------------------------------------

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=emkwambe/case-explorer

# Slack (for notifications)
SLACK_WEBHOOK_URL=

# -------------------------------------------
# FEATURE FLAGS
# -------------------------------------------

# Enable/disable features
FF_API_ENABLED=true
FF_ANALYTICS_ENABLED=false
FF_MULTI_LOAN_TYPES=false
FF_CUSTOM_FRAUD_PATTERNS=false
FF_DATASET_VERSIONING=false

# -------------------------------------------
# SECURITY SETTINGS
# -------------------------------------------

# CORS settings
CORS_ORIGIN=*  # For development only, restrict in production
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Origin,Content-Type,Authorization,Accept

# Helmet settings
HELMET_ENABLED=true

# Rate limit by IP (fallback when API key not provided)
IP_RATE_LIMIT=100
IP_RATE_LIMIT_WINDOW_MINUTES=60

# -------------------------------------------
# PRODUCTION SPECIFIC
# -------------------------------------------

# Uncomment and configure for production
# NODE_ENV=production
# LOG_LEVEL=warn
# CORS_ORIGIN=https://yourdomain.com
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTP_ONLY=true
# SESSION_COOKIE_SAME_SITE=lax

# -------------------------------------------
# TESTING
# -------------------------------------------

# Test database (optional - for running tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=case_explorer_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
