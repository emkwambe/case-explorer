{
  "name": "case-explorer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "node validate.js 1000 42",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node src/server.js",
    "start:dev": "node --env-file=.env src/server.js",
    "benchmark": "node scripts/benchmark.js --count 2000 --seed 42",
    "benchmark:quick": "node scripts/benchmark.js --count 500 --stratified 40 --seed 42",
    "datasets": "node scripts/build_datasets.js",
    "readme:metrics": "node scripts/update_readme_metrics.js",
    "test:ci": "vitest run --coverage --reporter=default"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mathjs": "^15.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-statistics": "^7.9.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.71.0",
    "supertest": "^7.2.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "description": "Mortgage risk simulation, fraud analytics and model-validation lab: synthetic borrower generation, rule and ML detection, governed decisioning, fairness testing and audit-ready evidence."
}
